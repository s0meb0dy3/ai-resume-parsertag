# ── 必填 ──────────────────────────────────────────────────────────
API_KEY=your_api_key_here

# ── 模型服务 ──────────────────────────────────────────────────────
MODEL_SERVICE_URL=http://<llm-host>:<port>/v1
MODEL_NAME=Qwen3.6-35B-A3B
ASYNC_MODEL_NAME=Qwen3.5-397B-A17B
SYNC_MODEL_NAME=Qwen3.6-35B-A3B

# 模型管理：未配置管理员凭证时禁止管理 API；运行时文件优先于上面的模型默认值
MODEL_ADMIN_TOKEN=
MODEL_CONFIG_FILE=/app/runtime/model_config.json
FALLBACK_MODELS=

# ── 推理参数 ──────────────────────────────────────────────────────
TEMPERATURE=0.01
MAX_TOKENS=4096
API_TIMEOUT=300
MAX_RETRIES=2
LLM_PREFIX_CACHE_ENABLED=true

# ── 并发 & 网络 ────────────────────────────────────────────────────
MAX_WORKERS=24
DOWNLOAD_TIMEOUT=60
SYNC_DOCUMENT_MAX_TEXT_CHARS=120000
TASK_TTL_MINUTES=120

# ── 服务端口 ──────────────────────────────────────────────────────
SERVICE_PORT=21804

# ── 时区 ──────────────────────────────────────────────────────────
TZ=Asia/Shanghai

# ── Langfuse 可观测性（可选）────────────────────────────────────────
# 两个 key 都配置后追踪自动启用；任意一个为空则静默跳过，不影响服务
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
# 支持 LANGFUSE_BASE_URL 或 LANGFUSE_HOST，内网部署时填内网地址
LANGFUSE_BASE_URL=http://****:3000
# 追踪环境标识（Langfuse v3 SDK 自动读取），可选值: production / staging / dev
LANGFUSE_TRACING_ENVIRONMENT=dev
# 逗号分隔多个 tag，在 Langfuse UI 的 Traces 列表中可按 tag 过滤
LANGFUSE_TAGS=dev_v2.3
