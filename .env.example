# ── 必填 ──────────────────────────────────────────────────────────
API_KEY=your_api_key_here

# ── 模型服务 ──────────────────────────────────────────────────────
MODEL_SERVICE_URL=http://<llm-host>:<port>/v1
MODEL_NAME=Qwen3.5-397B-A17B

# ── 推理参数 ──────────────────────────────────────────────────────
TEMPERATURE=0.01
MAX_TOKENS=4096
API_TIMEOUT=300
MAX_RETRIES=2

# ── 并发 & 网络 ────────────────────────────────────────────────────
MAX_WORKERS=24
DOWNLOAD_TIMEOUT=60

# ── 服务端口 ──────────────────────────────────────────────────────
SERVICE_PORT=21804

# ── 时区 ──────────────────────────────────────────────────────────
TZ=Asia/Shanghai

# ── Langfuse 可观测性（可选）────────────────────────────────────────
# 两个 key 都配置后追踪自动启用；任意一个为空则静默跳过，不影响服务
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_HOST=http://localhost:3100
# 逗号分隔多个 tag，在 Langfuse UI 的 Traces 列表中可按 tag 过滤
LANGFUSE_TAGS=dev_v2.3
